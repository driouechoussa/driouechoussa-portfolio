# =================================================================
#  Production environment for driouechoussa.me
#  Copy to `.env` on the server, fill in every value marked CHANGE,
#  then run `php artisan key:generate` once. Never commit the real .env.
# =================================================================

APP_NAME="driouechoussa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://driouechouss.me

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily log files, kept 14 days; only errors and above.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (CHANGE) -------------------------------------------
# MySQL/MariaDB (recommended on shared hosting):
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
# Or SQLite: DB_CONNECTION=sqlite and remove the DB_* lines above
# (the file is database/database.sqlite).

# --- Sessions, cache, queue --------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only over HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Mail is sent during the request, so no queue worker is needed.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# --- Mail (CHANGE) -----------------------------------------------
# SMTP account that sends the contact-form notifications.
# Use an address on your own domain for MAIL_FROM_ADDRESS, with SPF/DKIM
# set up at your DNS provider, or messages may land in spam.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=CHANGE_ME
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="hello@driouechoussa.me"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Portfolio ---------------------------------------------------
# Contact details are edited in /admin (Profile > Contact details);
# these are only the defaults until something is saved there.
PORTFOLIO_EMAIL=hello@driouechoussa.me
# Fallback recipient for contact-form messages (the admin email wins).
CONTACT_RECIPIENT=
# Comma-separated emails allowed into /admin (CHANGE).
ADMIN_EMAILS=CHANGE_ME
# Privacy-friendly analytics (Plausible); leave empty to disable.
PLAUSIBLE_DOMAIN=
PLAUSIBLE_HOST=https://plausible.io
# "*" (or proxy IPs) behind Cloudflare, a load balancer or a reverse proxy.
TRUSTED_PROXIES=
